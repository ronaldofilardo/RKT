# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Banco de dados — premissa P-01 (docs/RULES.md)
# development: SOMENTE o banco local racket_mvp (nunca o Neon)
DATABASE_URL_DEV=postgresql://postgres:password@localhost:5432/racket_mvp

# test: SOMENTE o banco local racket_mvp_test (vai em .env.test)
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/racket_mvp_test

# production: SOMENTE o banco do Neon, configurado no painel da Vercel/Neon.
# Nunca crie .env.production nesta máquina nem defina DATABASE_URL no seu shell.
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Criptografia de identidade (HMAC-SHA256 pepper para cpfHash do Player)
CPF_HASH_PEPPER=your-cpf-hash-pepper-here
