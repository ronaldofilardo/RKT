# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Banco de dados — premissa P-01 (docs/RULES.md)
# development: SOMENTE o banco local racket_mvp (nunca o Neon)
DATABASE_URL_DEV=postgresql://postgres:password@localhost:5432/racket_mvp

# test: SOMENTE o banco local racket_mvp_test (vai em .env.test)
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/racket_mvp_test

# production: SOMENTE o banco do Neon, configurado no painel da Vercel/Neon.
# Nunca crie .env.production nesta máquina nem defina DATABASE_URL no seu shell.
# A DATABASE_URL usa a porta do pooler (PgBouncer modo transaction) com connection_limit=1.
# A DIRECT_URL conecta direto ao nó Neon primário para migrações (prisma migrate).
# DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require&connection_limit=1
# DIRECT_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Criptografia de identidade (HMAC-SHA256 pepper para cpfHash do Player)
CPF_HASH_PEPPER=your-cpf-hash-pepper-here

# Gateway de Pagamento Asaas
ASAAS_ENV=production
ASAAS_API_KEY=your-asaas-api-key-here
ASAAS_WEBHOOK_TOKEN=your-asaas-webhook-token-here

# Rate limiting de tentativas de login (habilitado por padrão; configure como 'true' apenas se precisar desabilitar em desenvolvimento local)
# DISABLE_LOGIN_RATELIMIT=false

