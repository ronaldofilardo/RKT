{
  "name": "racket-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/db/preflight.ts --mode=development && node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "dev:memory": "tsx scripts/db/preflight.ts --mode=development && node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "build": "tsx scripts/db/preflight.ts --mode=production && prisma generate && next build",
    "start": "tsx scripts/db/preflight.ts --mode=production && next start",
    "lint": "next lint",
    "test": "tsx scripts/db/preflight.ts --mode=test && node scripts/run-tests.js --ci",
    "test:design": "tsx scripts/db/preflight.ts --mode=test && node scripts/run-tests.js --ci \"design-pattern.characterization\" \"dual-theme.characterization\" \"telemetry-integrity\"",
    "test:strict": "tsx scripts/db/preflight.ts --mode=test && pnpm typecheck && node scripts/check-no-skipped-tests.mjs && node scripts/run-tests.js --ci --runInBand",
    "check:r03": "node scripts/check-r03-line-limit.mjs",
    "test:watch": "tsx scripts/db/preflight.ts --mode=test && node -e \"process.env.NODE_ENV='test'; require('dotenv').config({path:'.env.test', override:true}); require('jest').run(['--watch'])\"",
    "test:coverage": "tsx scripts/db/preflight.ts --mode=test && node scripts/run-tests.js --ci --coverage --runInBand",
    "test:components": "tsx scripts/db/preflight.ts --mode=test && node scripts/run-tests.js --ci --config jest.components.config.js --runInBand",
    "test:e2e": "pnpm db:test:push && pnpm db:test:seed && playwright test",
    "db:audit:server-id": "tsx scripts/db/preflight.ts --mode=development -- tsx scripts/audit-server-id.ts",
    "db:backfill:tiebreak": "tsx scripts/db/preflight.ts --mode=development -- tsx scripts/backfill-tiebreak-scores.ts",
    "db:shadow-replay": "tsx scripts/db/preflight.ts --mode=development -- tsx scripts/shadow-replay-validator.ts",
    "db:check:access": "tsx scripts/db/preflight.ts --mode=development -- node scripts/check-access-consistency.mjs",
    "db:link:gestor-players": "tsx scripts/db/preflight.ts --mode=development -- tsx scripts/link-gestor-created-players.ts",
    "db:inject:annotators:prod": "tsx scripts/db/preflight.ts --mode=production -- tsx scripts/inject-annotators-prod.ts",
    "test:mutation": "tsx scripts/db/preflight.ts --mode=test && node scripts/run-mutation-diff.js",
    "db:where": "tsx scripts/db/preflight.ts --mode=development",
    "db:push": "tsx scripts/db/preflight.ts --mode=development -- prisma db push",
    "db:migrate": "tsx scripts/db/preflight.ts --mode=development -- prisma migrate dev",
    "db:seed": "tsx scripts/db/preflight.ts --mode=development -- tsx prisma/seed.ts",
    "spec:validate": "node scripts/validate-spec-drift.mjs",
    "typecheck": "tsc --noEmit",
    "test:setup": "tsx scripts/db/preflight.ts --mode=test -- node scripts/test-setup.js",
    "db:test:create": "tsx scripts/db/preflight.ts --mode=test -- node scripts/create-test-db.js",
    "db:test:push": "tsx scripts/db/preflight.ts --mode=test -- prisma db push --skip-generate",
    "db:test:seed": "tsx scripts/db/preflight.ts --mode=test -- tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "idb": "^8.0.0",
    "jose": "^5.6.0",
    "next": "^15.3.0",
    "postcss": "^8.5.15",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.46.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/jest-runner": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.0.0",
    "prisma": "^5.17.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": "node scripts/validate-characterization.js"
  }
}
