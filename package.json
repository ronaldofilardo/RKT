{
  "name": "racket-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "dev:memory": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-tests.js --ci",
    "test:strict": "pnpm typecheck && node scripts/check-no-skipped-tests.mjs && node scripts/run-tests.js --ci --runInBand",
    "test:watch": "node -e \"process.env.NODE_ENV='test'; require('dotenv').config({path:'.env.test'}); require('jest').run(['--watch'])\"",
    "test:coverage": "node scripts/run-tests.js --ci --coverage --runInBand",
    "test:components": "node scripts/run-tests.js --ci --config jest.components.config.js --runInBand",
    "test:e2e": "playwright test",
    "test:mutation": "node scripts/run-mutation-diff.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "spec:validate": "node scripts/validate-spec-drift.mjs",
    "typecheck": "tsc --noEmit",
    "test:setup": "node scripts/test-setup.js",
    "db:test:create": "node scripts/create-test-db.js",
    "db:test:push": "node -e \"require('dotenv').config({path:'.env.test'}); require('child_process').execSync('prisma db push --skip-generate', {stdio:'inherit'})\"",
    "db:test:seed": "node -e \"require('dotenv').config({path:'.env.test'}); require('child_process').execSync('tsx prisma/seed.ts', {stdio:'inherit'})\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "jose": "^5.6.0",
    "next": "^15.3.0",
    "postcss": "^8.5.15",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.46.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/jest-runner": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.0.0",
    "prisma": "^5.17.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": "node scripts/validate-characterization.js"
  }
}
