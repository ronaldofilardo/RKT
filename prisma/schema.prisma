generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  cpf            String?   @unique
  passwordHash   String
  role           Role      @default(ANNOTATOR)
  isActive       Boolean   @default(true)
  club           String?
  /// Base operacional (o "anotador"): cadastrar/buscar atletas, criar e anotar partidas.
  canOperate     Boolean   @default(false)
  /// Deve trocar a senha provisória no próximo acesso.
  mustChangePassword  Boolean   @default(false)
  /// Expiração da senha provisória (7 dias após emissão).
  tempPasswordExpiresAt DateTime?
  /// Incrementa para encerrar todas as sessões (troca de senha/vínculo/suspensão).
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships            Membership[]             @relation("UserMemberships")
  coachAthleteLinks      CoachAthleteLink[]       @relation("CoachAthleteLinks")
  supportAccessRequests  SupportAccessRequest[]   @relation("SupportAccessRequester")
  supportAccessTargets   SupportAccessRequest[]   @relation("SupportAccessTarget")
  supportAccessApprovals SupportAccessRequest[]   @relation("SupportAccessApprover")
  athleteProfile         Player?                  @relation("PlayerAccount")
  guardianLinks          GuardianLink[]           @relation("GuardianUser")
  consentRecords         ConsentRecord[]          @relation("GuardianConsent")
  athleteClaims          AthleteClaim[]           @relation("ClaimUser")
  passwordResets         PasswordResetRequest[]   @relation("ResetUser")
  createdMatches         Match[]                  @relation("CreatedMatches")
  annotationSessions     MatchAnnotationSession[] @relation("AnnotationSessions")
  endorsements           AnnotationEndorsement[]  @relation("Endorsements")
  scoreEdits             MatchScoreEdit[]         @relation("ScoreEdits")
  createdPlayers         Player[]                 @relation("CreatedPlayers")
  authoredComments       MatchComment[]           @relation("AuthoredComments")
  createdShareLinks      MatchShareLink[]         @relation("CreatedShareLinks")
  spectatingMatches      MatchSpectator[]         @relation("UserSpectators")

  @@map("users")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  cpf       String?
  createdAt DateTime @default(now())
  success   Boolean  @default(false)

  @@index([ip, createdAt])
  @@index([cpf, createdAt])
  @@map("login_attempts")
}

model Player {
  id              String    @id @default(cuid())
  name            String
  email           String?
  club            String?
  age             Int?
  backhand        String?
  dominance       String?
  gender          String?
  ranking         Int?
  rankings        Json?
  birthDate       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String?
  createdByUser   User?     @relation("CreatedPlayers", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Código curto público do atleta (pool global). Preenchido por script/serviço na Fase 2.
  athleteCode       String?            @unique
  /// Conta ligada ao atleta (vínculo ATLETA).
  userId            String?            @unique
  user              User?              @relation("PlayerAccount", fields: [userId], references: [id], onDelete: SetNull)
  clubId            String?
  clubRef           Club?              @relation("PlayerClub", fields: [clubId], references: [id], onDelete: SetNull)
  /// Hash HMAC-SHA256 do CPF (apenas atletas provisórios/sem conta). O CPF completo nunca fica aqui.
  cpfHash           String?
  /// Dois últimos dígitos do CPF (índice leve de busca por proximidade).
  cpfLast2          String?
  identityStatus    IdentityStatus     @default(CONFIRMED)
  mergedIntoId      String?
  mergedInto        Player?            @relation("PlayerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        Player[]           @relation("PlayerMerge")
  playerCts         PlayerCT[]
  guardianLinks     GuardianLink[]
  consentRecords    ConsentRecord[]
  athleteClaims     AthleteClaim[]
  coachAthleteLinks CoachAthleteLink[]

  matchesAsPlayer1        Match[] @relation("Player1")
  matchesAsPlayer2        Match[] @relation("Player2")
  matchesAsPlayer1Partner Match[] @relation("Player1Partner")
  matchesAsPlayer2Partner Match[] @relation("Player2Partner")

  @@index([name])
  @@map("Player")
}

model Match {
  id                 String                   @id @default(cuid())
  format             MatchFormat
  state              MatchState               @default(SCHEDULED)
  player1Id          String
  player2Id          String
  scoreState         Json?
  initialServerId    String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  sportType          String                   @default("TENNIS")
  courtType          String?
  nickname           String?
  visibility         String                   @default("PUBLIC")
  isResuming         Boolean                  @default(false)
  openForAnnotation  Boolean                  @default(false)
  tournamentName     String?
  round              String?
  bracketType        String?
  temperature        Float?
  humidity           Float?
  version            Int                      @default(0)
  category           String?
  winnerId           String?
  details            String?
  clubName           String?
  deletedAt          DateTime?
  deletedBy          String?
  finishNote         String?
  finishReason       MatchFinishReason?
  createdByUserId    String?
  matchType          MatchType                @default(SINGLES)
  player1PartnerId   String?
  player2PartnerId   String?
  doublesSetup       Json?
  /// CT dono da partida (tenant). Nulo = partida avulsa/legada.
  ctId               String?
  venueClubId        String?
  tournamentId       String?
  ct                 TrainingCenter?          @relation("CtMatches", fields: [ctId], references: [id], onDelete: SetNull)
  venueClub          Club?                    @relation("VenueMatches", fields: [venueClubId], references: [id], onDelete: SetNull)
  tournament         Tournament?              @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  createdByUser      User?                    @relation("CreatedMatches", fields: [createdByUserId], references: [id], onDelete: SetNull)
  player1            Player                   @relation("Player1", fields: [player1Id], references: [id])
  player2            Player                   @relation("Player2", fields: [player2Id], references: [id])
  player1Partner     Player?                  @relation("Player1Partner", fields: [player1PartnerId], references: [id])
  player2Partner     Player?                  @relation("Player2Partner", fields: [player2PartnerId], references: [id])
  pointLog           PointLog[]
  annotationSessions MatchAnnotationSession[]
  scoreEdits         MatchScoreEdit[]
  comments           MatchComment[]
  shareLinks         MatchShareLink[]
  spectators         MatchSpectator[]

  @@index([state])
  @@index([deletedAt])
  @@index([createdByUserId, createdAt(sort: Desc)])
  @@index([ctId])
  @@index([tournamentId])
}

model PointLog {
  id                String         @id @default(cuid())
  matchId           String
  winnerId          String
  type              PointType
  serverId          String
  annotations       Json?
  timestamp         DateTime       @default(now())
  audioNote         Bytes?
  audioNoteMime     String?
  audioNoteDuration Int?
  sequenceNumber    Int?
  clientEventId     String?
  voidedAt          DateTime?
  receivedAt        DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  match             Match          @relation(fields: [matchId], references: [id])
  comments          MatchComment[]

  @@unique([matchId, clientEventId])
  @@unique([matchId, sequenceNumber])
  @@index([matchId])
  @@index([matchId, voidedAt])
}

/// Registra cada correção manual de placar ("Editar Placar"), usada
/// tipicamente para retomar uma partida interrompida (ex.: anotador parou
/// no set 2, 3x2, 30-30, e depois ajusta o placar manualmente para
/// continuar no set 3). Preserva o snapshot `{state, history}` de ANTES da
/// edição — que o engine descarta localmente (`loadState` zera seu
/// `history` em memória) — para que o `/report` (e, no futuro, o módulo de
/// estatísticas) consiga reconstruir a timeline completa em segmentos,
/// inserindo um marcador de "interrupção" entre eles, em vez de perder ou
/// zerar os dados do trecho anterior à edição.
model MatchScoreEdit {
  id                 String   @id @default(cuid())
  matchId            String
  editedByUserId     String?
  editedByUser       User?    @relation("ScoreEdits", fields: [editedByUserId], references: [id], onDelete: SetNull)
  editedAt           DateTime @default(now())
  /// Snapshot `{state, history}` (ou apenas `state`, se o segmento anterior
  /// não tinha history detalhado) imediatamente antes desta edição.
  previousScoreState Json
  /// Snapshot `{state, history}` resultante da edição (novo ponto de
  /// partida para o segmento seguinte de anotação).
  newScoreState      Json
  note               String?
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([matchId, editedAt])
  @@map("match_score_edits")
}

model MatchComment {
  id                String    @id @default(cuid())
  matchId           String
  match             Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  content           String    @db.Text
  category          String?
  authorId          String
  author            User      @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  pointId           String?
  pointLog          PointLog? @relation(fields: [pointId], references: [id], onDelete: SetNull)
  audioNote         Bytes?
  audioNoteMime     String?
  audioNoteDuration Int?

  @@index([matchId, createdAt])
  @@map("match_comments")
}

model MatchAnnotationSession {
  id                 String                  @id @default(cuid())
  matchId            String
  annotatorUserId    String
  startedAt          DateTime                @default(now())
  endedAt            DateTime?
  matchStateSnapshot String?
  finalStateSnapshot String?
  isActive           Boolean                 @default(true)
  status             AnnotationSessionStatus @default(IN_PROGRESS)
  lastHeartbeatAt    DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @default(now()) @updatedAt
  endorsements       AnnotationEndorsement[]
  annotator          User                    @relation("AnnotationSessions", fields: [annotatorUserId], references: [id], onDelete: Cascade)
  match              Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([annotatorUserId])
  @@index([isActive])
  @@index([matchId, isActive])
  @@map("match_annotation_sessions")
}

model AnnotationEndorsement {
  id               String                 @id @default(cuid())
  sessionId        String
  endorsedByUserId String
  endorsedAt       DateTime               @default(now())
  endorsedBy       User                   @relation("Endorsements", fields: [endorsedByUserId], references: [id], onDelete: Cascade)
  session          MatchAnnotationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, endorsedByUserId])
  @@map("annotation_endorsements")
}

model MatchShareLink {
  id              String           @id @default(cuid())
  matchId         String
  createdByUserId String?
  tokenHash       String           @unique
  label           String?
  createdAt       DateTime         @default(now())
  revokedAt       DateTime?
  lastUsedAt      DateTime?

  match           Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdByUser   User?            @relation("CreatedShareLinks", fields: [createdByUserId], references: [id], onDelete: SetNull)
  spectators      MatchSpectator[]

  @@index([matchId, revokedAt])
  @@map("match_share_links")
}

model MatchSpectator {
  id        String          @id @default(cuid())
  matchId   String
  userId    String
  linkId    String?
  joinedAt  DateTime        @default(now())
  lastSeenAt DateTime?
  revokedAt DateTime?

  match     Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User            @relation("UserSpectators", fields: [userId], references: [id], onDelete: Cascade)
  link      MatchShareLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([matchId, userId])
  @@index([userId, revokedAt])
  @@map("match_spectators")
}

enum Role {
  ADMIN
  ANNOTATOR
}

enum MatchState {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchFinishReason {
  COMPLETED
  ABANDONED
  WALKOVER
  INJURY
  OUTRO
}

enum MatchFormat {
  BEST_OF_3
  BEST_OF_3_MATCH_TB
  BEST_OF_5
  BEST_OF_3_NO_AD
  SHORT_SET_2V2_NO_AD
  MATCH_TB_10
  PRO_SET_8
}

enum PointType {
  ACE
  WINNER
  FORCED_ERROR
  UNFORCED_ERROR
  DOUBLE_FAULT
  FAULT_FIRST
  FAULT_SECOND
}

enum AnnotationSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum MatchType {
  SINGLES
  DOUBLES
}

// ─── Fundação de acesso (PLANO_FUNDACAO_PERFIS_v2) ──────────────────────────

/// CT (Centro de Treinamento) = dono dos dados (tenant).
model TrainingCenter {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  /// CNPJ normalizado (14 dígitos numéricos).
  cnpj            String?      @unique
  /// Razão Social da Pessoa Jurídica.
  legalName       String?
  /// Telefone institucional.
  phone           String?
  /// E-mail institucional.
  email           String?
  /// Endereço estruturado (rua, número, complemento, bairro, cidade, estado, CEP).
  address         Json?
  /// Nome do Representante Legal.
  legalRepName    String?
  /// CPF do Representante Legal.
  legalRepCpf     String?
  /// E-mail do Representante Legal.
  legalRepEmail   String?
  /// Telefone do Representante Legal.
  legalRepPhone   String?
  status          String       @default("PENDING")
  createdAt       DateTime     @default(now())
  createdByUserId String?
  memberships     Membership[]
  playerCts       PlayerCT[]
  linkInvites     LinkInvite[]
  matches         Match[]      @relation("CtMatches")
  tournaments     Tournament[]
  clubs           Club[]       @relation("ClubCt")

  @@map("training_centers")
}

model Tournament {
  id              String         @id @default(cuid())
  ctId            String
  name            String
  status          String         @default("ACTIVE")
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  ct              TrainingCenter @relation(fields: [ctId], references: [id], onDelete: Cascade)
  matches         Match[]

  @@unique([ctId, name])
  @@index([ctId, status])
  @@map("tournaments")
}

/// Clube = apenas referência (adversário de fora, local da partida).
model Club {
  id           String   @id @default(cuid())
  name         String
  city         String?
  /// CT vinculado (único). Clube é referência/venue; CT é a entidade operacional.
  ctId         String?  @unique
  ct           TrainingCenter? @relation("ClubCt", fields: [ctId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  players      Player[] @relation("PlayerClub")
  venueMatches Match[]  @relation("VenueMatches")

  @@unique([name, city])
  @@map("clubs")
}

/// Vínculo de uma conta com a plataforma ou com um CT. ATLETA não é linha
/// daqui: é `Player.userId`. `ctId` nulo = avulso (treinador) ou plataforma.
model Membership {
  id              String           @id @default(cuid())
  userId          String
  kind            MembershipKind
  preset          PlatformPreset?
  ctId            String?
  status          MembershipStatus @default(ACTIVE)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  endedAt         DateTime?
  user            User           @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  ct              TrainingCenter?  @relation(fields: [ctId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, ctId])
  @@index([userId, status])
  @@index([ctId])
  @@map("memberships")
}

/// Atleta ↔ CT (um atleta pode estar em vários CTs).
model PlayerCT {
  id       String         @id @default(cuid())
  playerId String
  ctId     String
  status   String         @default("ACTIVE")
  since    DateTime       @default(now())
  endedAt  DateTime?
  player   Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ct       TrainingCenter @relation(fields: [ctId], references: [id], onDelete: Cascade)

  @@unique([playerId, ctId])
  @@index([ctId])
  @@map("player_cts")
}

model GuardianLink {
  id             String    @id @default(cuid())
  guardianUserId String
  playerId       String
  relation       String?
  confirmedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  guardian       User      @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: Cascade)
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([guardianUserId])
  @@index([playerId])
  @@map("guardian_links")
}

model ConsentRecord {
  id             String         @id @default(cuid())
  guardianUserId String
  playerId       String
  purpose        ConsentPurpose
  termsVersion   String
  grantedAt      DateTime       @default(now())
  revokedAt      DateTime?
  ipHash         String?
  guardian       User           @relation("GuardianConsent", fields: [guardianUserId], references: [id], onDelete: Cascade)
  player         Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("consent_records")
}

model AthleteClaim {
  id              String      @id @default(cuid())
  userId          String
  playerId        String
  status          ClaimStatus @default(PENDING)
  decidedByUserId String?
  createdAt       DateTime    @default(now())
  user            User        @relation("ClaimUser", fields: [userId], references: [id], onDelete: Cascade)
  player          Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([playerId])
  @@map("athlete_claims")
}

model CoachAthleteLink {
  id          String                 @id @default(cuid())
  coachUserId String
  playerId    String
  status      CoachAthleteLinkStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  respondedAt DateTime?
  endedAt     DateTime?
  coach       User                   @relation("CoachAthleteLinks", fields: [coachUserId], references: [id], onDelete: Cascade)
  player      Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([coachUserId, playerId])
  @@index([playerId, status])
  @@map("coach_athlete_links")
}

model SupportAccessRequest {
  id               String              @id @default(cuid())
  requesterUserId  String
  targetUserId     String
  reason           String
  status           SupportAccessStatus @default(PENDING)
  createdAt        DateTime            @default(now())
  decidedAt        DateTime?
  expiresAt        DateTime?
  accessedAt       DateTime?
  requester        User                @relation("SupportAccessRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  target           User                @relation("SupportAccessTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  approver         User?               @relation("SupportAccessApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId String?

  @@index([requesterUserId, status, createdAt])
  @@index([status, createdAt])
  @@map("support_access_requests")
}

/// Convite de vínculo (link + código entregues manualmente; só hashes são guardados).
model LinkInvite {
  id              String         @id @default(cuid())
  ctId            String
  kind            InviteKind
  tokenHash       String         @unique
  codeHash        String
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  maxUses         Int            @default(1)
  createdAt       DateTime       @default(now())
  ct              TrainingCenter @relation(fields: [ctId], references: [id], onDelete: Cascade)

  @@index([ctId])
  @@map("link_invites")
}

model PasswordResetRequest {
  id             String      @id @default(cuid())
  userId         String
  status         ResetStatus @default(PENDING)
  contactHint    String?
  requestedAt    DateTime    @default(now())
  requestIpHash  String?
  issuedByUserId String?
  tokenHash      String?     @unique
  tokenExpiresAt DateTime?
  doneAt         DateTime?
  user           User        @relation("ResetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([userId])
  @@map("password_reset_requests")
}

/// Somente eventos sensíveis (nunca leituras). Sem FK: sobrevive à exclusão de contas.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  ctId         String?
  meta         Json?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([ctId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

enum PlatformPreset {
  ADMIN
  SUPORTE
}

enum MembershipKind {
  PLATAFORMA
  GESTOR
  TREINADOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum IdentityStatus {
  CONFIRMED
  PROVISIONAL
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResetStatus {
  PENDING
  LINK_ISSUED
  DONE
  REJECTED
}

/// BROADCAST entra junto com a transmissão ao vivo.
enum ConsentPurpose {
  DATA
  BROADCAST
}

enum InviteKind {
  TREINADOR
  ATLETA
  GESTOR
}

enum CoachAthleteLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  ENDED
}

enum SupportAccessStatus {
  PENDING
  APPROVED
  REJECTED
}
